# ============================================================
# Variáveis de ambiente para docker-compose do HydroTrack
# Copie este arquivo para .env na raiz do projeto e ajuste os valores.
# ============================================================

# Aplicação (usadas pelo Laravel, podem ser sobrescritas no backend/.env)
APP_NAME=HydroTrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Banco de dados (usadas pelo docker-compose e pelo Laravel)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=hydrotrack
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Controle de migrations no entrypoint do container de produção
RUN_MIGRATIONS=false

# Autenticação de sessão/API para desenvolvimento local
SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DOMAIN=localhost
SESSION_ENCRYPT=true

# Cache (database para desenvolvimento local, redis para produção)
CACHE_STORE=database
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Simulação IoT
IOT_SIMULATION_INTERVAL_MS=2000
IOT_BOCAIUVA_CENTER_LAT=-17.1085
IOT_BOCAIUVA_CENTER_LNG=-43.8143
IOT_BOCAIUVA_RADIUS_KM=3.5

# Autenticação M2M (API key para endpoint de ingestão)
# Gere uma chave segura com: php -r "echo bin2hex(random_bytes(32));"
INGEST_API_KEY=
